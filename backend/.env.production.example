# 本番環境用環境変数（Render）

# Database（Renderが自動設定）
DATABASE_URL=postgresql://user:password@host:5432/database

# Security（Renderが自動生成推奨）
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS（Vercelフロントエンドを許可）
BACKEND_CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]

# Environment
ENVIRONMENT=production

# 初期管理者ユーザー
FIRST_SUPERUSER_EMAIL=admin@tokyobaynet.com
FIRST_SUPERUSER_PASSWORD=change-this-password
FIRST_SUPERUSER_USERNAME=admin
